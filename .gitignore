# iOS specific
*.xcodeproj/
*.xcworkspace/
Pods/
*.pbxproj
*.plist
*.xcconfig

# Android specific
*.gradle
local.properties
gradle-wrapper.jar
/.idea
*.iml
.gradle/
build/
release/
debug/
captures/
.externalNativeBuild
.cxx

# Modified files to track
!android/app/src/main/AndroidManifest.xml
!android/app/src/main/res/values/strings.xml
